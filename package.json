{
  "name": "star-survivors",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "星际幸存者 — a sci-fi Vampire Survivors-like built with Phaser 4 + TypeScript",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "assets": "npm run assets:fetch && npm run assets:floor && npm run assets:atlas && npm run assets:audio",
    "assets:fetch": "node scripts/fetch-assets.mjs",
    "assets:floor": "node scripts/build-floor.mjs",
    "assets:atlas": "node scripts/build-atlas.mjs",
    "assets:audio": "node scripts/copy-audio.mjs",
    "assets:icons": "node scripts/build-icons.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=default",
    "test:mobile": "playwright test --project=mobile",
    "test:iphone": "playwright test --project=iphone",
    "test:portrait": "playwright test --project=portrait",
    "test:perf": "playwright test --project=perf",
    "bench": "playwright test --project=bench",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:e2e && npm run test:mobile && npm run test:iphone && npm run test:portrait && npm run test:perf",
    "cap:sync": "npm run build && cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@revenuecat/purchases-capacitor": "^13.5.1",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "free-tex-packer-core": "^0.3.9",
    "globals": "^17.12.0",
    "jimp": "^1.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
